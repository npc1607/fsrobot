{
  "app_id": "cli_xxxxxxxxxxxx",
  "app_secret": "yyyyyyyyyyyyyyyyyyyyyyyyyyyy",
  "require_at": false,
  "admin_open_ids": [],
  "default_agent": "gp",
  "agents": [
    {
      "id": "gp",
      "type": "agp",
      "name": "GP Agent",
      "description": "高性能 Go Agent（自定义 AGP 协议）",
      "endpoint": "unix:///tmp/gp-agent.sock",
      "work_dir": "."
    },
    {
      "id": "pi",
      "type": "pi",
      "name": "Pi Agent",
      "description": "原生 Pi CLI Agent",
      "bin": "/opt/homebrew/bin/pi",
      "work_dir": ".",
      "enable_session": true,
      "session_dir": "./sessions"
    }
  ]
}
